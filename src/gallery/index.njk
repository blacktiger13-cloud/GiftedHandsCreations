---
layout: layouts/base.njk
title: Gallery
description: Browse handmade wood art from Gifted Hands Creations — American flag art, wooden heart décor, and custom engraved keepsakes.
permalink: /gallery/
---
<section class="section section--tan">
  <div class="wrap">
    <h1 class="page-heading">Gallery</h1>
    <div class="showcase-grid">
      {% for item in portfolio %}
      <a href="/gallery/{{ item.slug }}/" class="showcase-grid__item" aria-label="{{ item.title }}">
        <picture>
          <source srcset="{{ item.galleryPageImageWebp }}" type="image/webp">
          <img src="{{ item.galleryPageImage }}" alt="{{ item.galleryPageImageAlt }}" loading="lazy" width="1000" height="667">
        </picture>
        <span class="showcase-grid__overlay" aria-hidden="true"></span>
        <span class="showcase-grid__title" aria-hidden="true">{{ item.navTitle or item.title }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
