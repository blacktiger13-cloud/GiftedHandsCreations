---
layout: layouts/base.njk
title: Gallery
description: Browse handmade wood art from Gifted Hands Creations — American flag art, wooden heart décor, and custom engraved keepsakes.
permalink: /gallery/
---
<section class="section section--tan">
  <div class="wrap">
    <div class="showcase-grid">
      {% for item in portfolio %}
      <a href="/gallery/{{ item.slug }}/" class="showcase-grid__item" aria-label="{{ item.title }}">
        <picture>
          <source srcset="{{ item.heroImageWebp }}" type="image/webp">
          <img src="{{ item.heroImage }}" alt="{{ item.heroImageAlt }}" loading="lazy" width="460" height="195">
        </picture>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
