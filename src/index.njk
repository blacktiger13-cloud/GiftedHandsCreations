---
layout: layouts/base.njk
description: Veteran-owned, handmade woodcraft — American flag art, wooden heart décor, and custom engraved keepsakes. Heartfelt Handiworks, made one piece at a time.
permalink: /
---
<section class="hero" style="background-image: url('/assets/images/hero-home.svg');">
  <div class="wrap hero__inner">
    <h1>{{ site.hero.heading }}</h1>
    <p>{{ site.hero.subheading }}</p>
    <p><a class="btn btn--pill btn--hero" href="{{ site.hero.ctaHref }}">{{ site.hero.ctaLabel }}</a></p>
  </div>
</section>

<section class="section section--badges">
  <div class="wrap">
    <ul class="badges" aria-label="Why buy from us">
      {% for badge in site.badges %}
      <li class="badge">
        <img class="badge__icon" src="{{ badge.icon }}" alt="" width="72" height="72" loading="lazy">
        <p class="badge__label">{{ badge.label }}</p>
        <p class="badge__desc">{{ badge.description }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section section--tan">
  <div class="wrap">
    <div class="section__heading">
      <h2>Our Gallery Collections</h2>
    </div>
    <div class="collection-grid">
      {% for item in portfolio %}
      <div class="collection-card">
        <a href="/gallery/{{ item.slug }}/" class="collection-card__image">
          <img src="{{ item.heroImage }}" alt="" loading="lazy" width="800" height="600">
        </a>
        <h3><a href="/gallery/{{ item.slug }}/">{{ item.title }}</a></h3>
        <p>{{ item.shortDescription }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
