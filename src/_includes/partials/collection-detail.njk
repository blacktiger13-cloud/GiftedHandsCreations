{% macro collectionDetail(slug) %}
{% for item in portfolio %}
{% if item.slug == slug %}
{% set prevItem = portfolio[loop.index0 - 1] if loop.index0 > 0 else null %}
{% set nextItem = portfolio[loop.index0 + 1] if loop.index0 < portfolio.length - 1 else null %}
<section class="section section--tan">
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/gallery/">Gallery</a></li>
        <li aria-current="page">{{ item.navTitle or item.title }}</li>
      </ol>
    </nav>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Gallery", "item": "{{ site.url }}/gallery/" },
        { "@type": "ListItem", "position": 3, "name": "{{ item.navTitle or item.title }}", "item": "{{ site.url }}/gallery/{{ item.slug }}/" }
      ]
    }
    </script>

    {% if prevItem or nextItem %}
    <div class="collection-pager collection-pager--top">
      {% if prevItem %}
      <a class="collection-pager__link collection-pager__link--prev" href="/gallery/{{ prevItem.slug }}/">
        <span aria-hidden="true">&lsaquo;</span> {{ prevItem.navTitle or prevItem.title }}
      </a>
      {% else %}
      <span></span>
      {% endif %}

      {% if nextItem %}
      <a class="collection-pager__link collection-pager__link--next" href="/gallery/{{ nextItem.slug }}/">
        {{ nextItem.navTitle or nextItem.title }} <span aria-hidden="true">&rsaquo;</span>
      </a>
      {% endif %}
    </div>
    {% endif %}

    <h1 class="page-heading">{{ item.navTitle or item.title }}</h1>

    <div class="gallery-grid" style="--tile-ratio: {{ item.imageAspectRatio or '4 / 3' }};" data-lightbox-group="{{ item.slug }}">
      {% for img in item.images %}
      <figure>
        <a class="gallery-grid__trigger" href="{{ img.src }}" data-lightbox-alt="{{ img.alt }}">
          {% if img.webp %}
          <picture>
            <source srcset="{{ img.webp }}" type="image/webp">
            <img src="{{ img.src }}" alt="{{ img.alt }}" loading="lazy" width="{{ img.w or 800 }}" height="{{ img.h or 800 }}">
          </picture>
          {% else %}
          <img src="{{ img.src }}" alt="{{ img.alt }}" loading="lazy" width="{{ img.w or 800 }}" height="{{ img.h or 800 }}">
          {% endif %}
        </a>
      </figure>
      {% endfor %}
    </div>

    <div class="collection-cta">
      <p>Love what you see? Every piece here was custom built for someone — yours can be too.</p>
      <a class="btn btn--pill" href="/contact/">Start Your Custom Order</a>
    </div>

    <div class="collection-pager">
      {% if prevItem %}
      <a class="collection-pager__link collection-pager__link--prev" href="/gallery/{{ prevItem.slug }}/">
        <span aria-hidden="true">&lsaquo;</span> {{ prevItem.navTitle or prevItem.title }}
      </a>
      {% else %}
      <span></span>
      {% endif %}

      {% if nextItem %}
      <a class="collection-pager__link collection-pager__link--next" href="/gallery/{{ nextItem.slug }}/">
        {{ nextItem.navTitle or nextItem.title }} <span aria-hidden="true">&rsaquo;</span>
      </a>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
{% endfor %}
{% endmacro %}
