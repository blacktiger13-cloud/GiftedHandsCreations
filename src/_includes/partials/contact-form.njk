{% macro contactForm(submitLabel="Send") %}
<p class="form-error" id="formError" hidden>Something went wrong sending your message. Please try again, or email us directly at <a href="mailto:{{ site.email }}">{{ site.email }}</a>.</p>
<form class="form" action="/api/contact" method="POST">
  <div class="form-group">
    <span class="form-group__label">Name</span>
    <div class="form-row">
      <div>
        <label for="firstName">First Name <span class="required">(required)</span></label>
        <input type="text" id="firstName" name="firstName" autocomplete="given-name" required>
      </div>
      <div>
        <label for="lastName">Last Name <span class="required">(required)</span></label>
        <input type="text" id="lastName" name="lastName" autocomplete="family-name" required>
      </div>
    </div>
  </div>

  <div>
    <label for="email">Email <span class="required">(required)</span></label>
    <input type="email" id="email" name="email" autocomplete="email" required>
  </div>

  <div>
    <label for="message">Message <span class="required">(required)</span></label>
    <textarea id="message" name="message" rows="6" required></textarea>
  </div>

  <div class="form-honeypot" aria-hidden="true">
    <label for="website">Leave this field blank</label>
    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
  </div>

  <input type="hidden" name="formLoadedAt" id="formLoadedAt" value="">
  <script>document.getElementById("formLoadedAt").value = Date.now();</script>

  <div class="cf-turnstile" data-sitekey="{{ site.turnstileSiteKey }}"></div>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <div>
    <button class="btn btn--pill btn--dark" type="submit">{{ submitLabel }}</button>
  </div>
</form>
{% endmacro %}
