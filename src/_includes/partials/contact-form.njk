{% macro contactForm(submitLabel="Send") %}
<!--
  Placeholder form action — replace YOUR_FORM_ID with a real Formspree
  endpoint (https://formspree.io) or swap this for a Cloudflare Pages
  Function at /functions/contact.js. See README for details.
-->
<form class="form" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
  <div class="form-group">
    <span class="form-group__label">Name</span>
    <div class="form-row">
      <div>
        <label for="firstName">First Name <span class="required">(required)</span></label>
        <input type="text" id="firstName" name="firstName" autocomplete="given-name" required>
      </div>
      <div>
        <label for="lastName">Last Name <span class="required">(required)</span></label>
        <input type="text" id="lastName" name="lastName" autocomplete="family-name" required>
      </div>
    </div>
  </div>

  <div>
    <label for="email">Email <span class="required">(required)</span></label>
    <input type="email" id="email" name="_replyto" autocomplete="email" required>
  </div>

  <div>
    <label for="message">Message <span class="required">(required)</span></label>
    <textarea id="message" name="message" rows="6" required></textarea>
  </div>

  <div>
    <button class="btn btn--pill btn--dark" type="submit">{{ submitLabel }}</button>
  </div>
</form>
{% endmacro %}
