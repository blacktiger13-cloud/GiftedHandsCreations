<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }} — {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }} — {{ site.tagline }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ image or '/assets/images/hero-home.jpg' }}">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}

  <div class="lightbox" id="lightbox" hidden>
    <button type="button" class="lightbox__close" aria-label="Close">&times;</button>
    <button type="button" class="lightbox__nav lightbox__nav--prev" aria-label="Previous image">&lsaquo;</button>
    <div class="lightbox__stage">
      <img class="lightbox__img" src="" alt="">
      <p class="lightbox__caption"></p>
    </div>
    <button type="button" class="lightbox__nav lightbox__nav--next" aria-label="Next image">&rsaquo;</button>
  </div>

  <button type="button" class="back-to-top" aria-label="Back to top" hidden>&uarr;</button>

  <script src="/assets/js/nav.js" defer></script>
  <script src="/assets/js/lightbox.js" defer></script>
  <script src="/assets/js/back-to-top.js" defer></script>
</body>
</html>
